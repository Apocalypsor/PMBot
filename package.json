{
  "name": "pmbot",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "cf-typegen": "wrangler types",
    "typegen": "wrangler types",
    "typecheck": "bun check",
    "lint": "biome check --no-errors-on-unmatched --files-ignore-unknown=true",
    "fix": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/node": "^25.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "wrangler": "^4.94.0"
  },
  "dependencies": {
    "elysia": "^1.4.28",
    "grammy": "^1.43.0"
  },
  "lint-staged": {
    "*": [
      "biome check --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
